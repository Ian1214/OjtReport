includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # Keep the deploy gate green at the highest level currently clean across the
    # legacy codebase. CI also runs level 7 as a visible, non-blocking ratchet.
    level: 1
